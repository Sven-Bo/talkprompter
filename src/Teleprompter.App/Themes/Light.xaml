<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Bg" Color="#F3F5F9" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#E8ECF2" />
    <SolidColorBrush x:Key="BorderCol" Color="#D3DAE4" />
    <SolidColorBrush x:Key="TextCol" Color="#17202B" />
    <SolidColorBrush x:Key="Muted" Color="#5D6775" />
    <SolidColorBrush x:Key="Accent" Color="#3B7DF2" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Highlight" Color="#FFD37A" />
    <SolidColorBrush x:Key="HighlightText" Color="#241A05" />
    <SolidColorBrush x:Key="TrackingCol" Color="#0FA968" />
    <SolidColorBrush x:Key="PausedCol" Color="#C97E0A" />
    <SolidColorBrush x:Key="LostCol" Color="#D64545" />

    <!-- Hover veil laid over buttons; opacity is animated by the templates -->
    <SolidColorBrush x:Key="VeilBrush" Color="#000000" />

    <!-- Overlays and accessories -->
    <SolidColorBrush x:Key="OverlayScrim" Color="#DDF3F5F9" />
    <SolidColorBrush x:Key="HeardStripBg" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="MeterTrack" Color="#1F000000" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#B9C2CF" />

    <LinearGradientBrush x:Key="TopFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F3F5F9" Offset="0" />
        <GradientStop Color="#00F3F5F9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomFade" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#F3F5F9" Offset="0" />
        <GradientStop Color="#00F3F5F9" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
