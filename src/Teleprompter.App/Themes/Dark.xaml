<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Bg" Color="#0F1115" />
    <SolidColorBrush x:Key="Surface" Color="#181C24" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#20262F" />
    <SolidColorBrush x:Key="BorderCol" Color="#2B313C" />
    <SolidColorBrush x:Key="TextCol" Color="#E7EAF0" />
    <SolidColorBrush x:Key="Muted" Color="#8B93A3" />
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentText" Color="#08101F" />
    <SolidColorBrush x:Key="Highlight" Color="#FFD37A" />
    <SolidColorBrush x:Key="HighlightText" Color="#1A1205" />
    <SolidColorBrush x:Key="TrackingCol" Color="#34D399" />
    <SolidColorBrush x:Key="PausedCol" Color="#F5A524" />
    <SolidColorBrush x:Key="LostCol" Color="#F87171" />

    <!-- Hover veil laid over buttons; opacity is animated by the templates -->
    <SolidColorBrush x:Key="VeilBrush" Color="#FFFFFF" />

    <!-- Overlays and accessories -->
    <SolidColorBrush x:Key="OverlayScrim" Color="#E00F1115" />
    <SolidColorBrush x:Key="HeardStripBg" Color="#CC181C24" />
    <SolidColorBrush x:Key="MeterTrack" Color="#33000000" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#4A5262" />

    <LinearGradientBrush x:Key="TopFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F1115" Offset="0" />
        <GradientStop Color="#000F1115" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomFade" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#0F1115" Offset="0" />
        <GradientStop Color="#000F1115" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
